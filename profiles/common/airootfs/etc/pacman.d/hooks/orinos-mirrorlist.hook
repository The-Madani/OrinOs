[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = pacman-mirrorlist

[Action]
Description = Writing the OrinOs default mirrorlist...
When = PostTransaction
Depends = pacman-mirrorlist
Exec = /usr/bin/sh -c 'printf "%s\n" "# Default Arch Linux mirrorlist for the OrinOs live medium." "# The installer also writes its own mirror configuration on the target system." "Server = https://geo.mirror.pkgbuild.com/\$repo/os/\$arch" "Server = https://mirror.rackspace.com/archlinux/\$repo/os/\$arch" "Server = https://mirror.os6.org/arch/\$repo/os/\$arch" > /etc/pacman.d/mirrorlist'
