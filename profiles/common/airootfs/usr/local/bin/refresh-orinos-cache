#!/usr/bin/env bash
# Materialize the embedded offline package cache at /orinos-cache (tmpfs).
#
# The live airootfs is read-only (erofs) but the offline installer has to read
# package files from it while pacman resolves an installation. /orinos-cache is
# referenced by CacheDir in pacman.conf, so the path has to be writable and
# stable — /opt/orinos-cache inside the image would be fine for reads, but the
# same pacman.conf is copied into the installed system during setup, where
# /orinos-cache is where the offline cache is expected to live.
set -euo pipefail

mkdir -p /orinos-cache

if [ -d /opt/orinos-cache ]; then
    # -n keeps the copy cheap; the cache is read-only data that never changes
    # within a session.
    cp -an /opt/orinos-cache/. /orinos-cache/
fi

count=$(find /orinos-cache -maxdepth 1 -name '*.pkg.tar.*' -type f 2>/dev/null | wc -l)
if [ "${count}" -eq 0 ]; then
    echo "refresh-orinos-cache: no embedded package cache found; offline install unavailable" >&2
    exit 1
fi

echo "refresh-orinos-cache: ${count} packages available for offline install" >&2